# P0 uses deterministic mock outputs while all wallet and settlement actions remain live.
AGENT_EXECUTION_MODE=mock

# Testnet-only wallets. Never put these values in VITE_* variables or commit .env.
REQUESTER_PRIVATE_KEY=
REPAIR_AGENT_PRIVATE_KEY=
COLOR_AGENT_PRIVATE_KEY=
STORY_AGENT_PRIVATE_KEY=
GUARD_AGENT_PRIVATE_KEY=
ROGUE_AGENT_PRIVATE_KEY=
