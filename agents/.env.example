# Public network configuration
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MONAD_CHAIN_NAME=Monad Testnet
MONAD_EXPLORER_URL=https://testnet.monadexplorer.com
ANT_COLONY_ADDRESS=
POLLING_INTERVAL_MS=800
RUNNER_FROM_BLOCK=
